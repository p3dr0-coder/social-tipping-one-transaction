# philia environment template.
# Copy this file to web/.env.local for the Next.js app, and export the demo
# variables in your shell before running demo/social-loop.mjs or demo/measure.mjs.

# --- web app (NEXT_PUBLIC_* values are baked in at build time) ---
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_PHILIA_CONTRACT=philia.testnet
# FastData receiver: same value on every network.
NEXT_PUBLIC_PHILIA_SOCIAL_RECEIVER=social
# SocialDB contract id is used only by the testnet adapter.
NEXT_PUBLIC_PHILIA_SOCIALDB_CONTRACT_ID=v1.social08.testnet
# Circle testnet USDC (6 decimals) for the demo; wrap.testnet is the 24-decimal fallback.
NEXT_PUBLIC_PHILIA_TIP_FT=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
# Optional NEP-516 `evm-on-near` manifest URL so MetaMask-controlled
# 0x… accounts can sign in through the same connector. Leave empty to load native wallets only.
NEXT_PUBLIC_PHILIA_EVM_MANIFEST=

# --- demo network selection ---
# testnet (default) uses the SocialDB adapter + faucet-funded accounts; mainnet uses
# social.__fastdata_kv + api2 and spends real funds (tips stay off unless TIP_FT is set).
PHILIA_NETWORK=testnet

# --- scripts ---
PHILIA_CONTRACT=philia.testnet

# --- zero-funds testnet demo ---
TIP_FT=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
SOCIALDB_CONTRACT_ID=v1.social08.testnet
# Optional RPC override for the demo scripts.
NEAR_RPC_URL=https://rpc.testnet.near.org

# Demo accounts created by scripts/create-accounts.sh.
ALICE_ACCOUNT=alice.philia.testnet
BOB_ACCOUNT=bob.philia.testnet
# Export the key in your shell only. A private key must never be committed,
# pasted into an issue, or written into any file tracked by git.
ALICE_PRIVATE_KEY=
