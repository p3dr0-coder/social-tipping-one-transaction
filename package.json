{
  "name": "near-philia",
  "version": "0.1.0",
  "private": true,
  "description": "philia — sovereign social on NEAR: FastData social writes, SocialDB on testnet, NEP-141 tipping with on-chain tip preferences.",
  "license": "MIT",
  "workspaces": [
    "web",
    "demo"
  ],
  "scripts": {
    "dev": "pnpm --filter philia-web dev",
    "build": "pnpm --filter philia-web build",
    "start": "pnpm --filter philia-web start",
    "lint": "pnpm --filter philia-web lint",
    "check-types": "pnpm --filter philia-web check-types",
    "format": "pnpm --filter philia-web format",
    "contract:build": "cd contract && cargo near build non-reproducible-wasm",
    "contract:test": "cd contract && cargo test",
    "demo:social": "node demo/social-loop.mjs",
    "demo:measure": "node demo/measure.mjs"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10.4.1"
  }
}
